+        ann_filepath = os.path.join(dataset_dir , 'annotations')
+        if round != None:
+            ann_filepath += "_" + str(round) + "_" + subset + ".json"
+        else:
+            ann_filepath += ".json"
+
+        assert os.path.isfile(ann_filepath)
