+            if class_name != 'Background':
+                self.add_class("taco", i, class_name)
+                image_ids.extend(list(taco_alla_coco.getImgIds(catIds=i)))
+            else:
+                background_id = i
+        image_ids = list(set(image_ids))
+
+        if background_id > -1:
+            class_ids.remove(background_id)
