+    "print(\" CSV/요약 :\", BATCH_OUTPUT_DIR)\n",
+    "print(\" 결과 영상:\", RESULT_VIDEO_DIR)\n",
+    "print(\"========================================\")\n",
+    "for stem, err in failed:\n",
+    "    print(\" -\", stem, err)"
+   ]
