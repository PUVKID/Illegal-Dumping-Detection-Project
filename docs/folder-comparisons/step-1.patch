+    "if target is None:\n",
+    "    raise ValueError(f\"해당 label의 영상이 없습니다: {PLOT_LABEL}\")\n",
+    "\n",
+    "fig, axes = plt.subplots(2, 1, figsize=(14, 8), sharex=True)\n",
+    "\n",
+    "for n, key in enumerate(trash_models):\n",
+    "    csv_path = BATCH_OUTPUT_DIR / key / f\"{target.stem}.csv\"\n",
+    "    if not csv_path.exists():\n",
+    "        continue\n",
+    "    df = pd.read_csv(csv_path)\n",
+    "\n",
+    "    axes[0].plot(df[\"video_sec\"], df[\"trash_count\"], label=f\"trash [{key}]\")\n",
