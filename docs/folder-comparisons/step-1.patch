+    "#   3) 결과 mp4 저장 (SAVE_VIDEO_FOR에 포함된 모델만)\n",
+    "#   - 출력: BATCH_OUTPUT_DIR / <모델키> / <영상이름>.csv, .json (요약)\n",
+    "#           RESULT_VIDEO_DIR / <모델키> / <영상이름>.mp4\n",
+    "#   - 중간에 멈춰도 RESUME=True 이면 이어서 진행\n",
+    "# ============================================================\n",
+    "\n",
+    "import re\n",
+    "import csv\n",
+    "from tqdm import tqdm\n",
+    "\n",
+    "LOW_CONF = 0.5   # 이보다 낮은 confidence 비율을 불안정 지표로 사용\n",
+    "\n",
+    "CSV_HEADER = [\"frame\", \"video_sec\", \"person_count\", \"trash_count\",\n",
+    "              \"max_trash_confidence\", \"trash_removed_person_overlap\", \"trash_static_ignored\"]\n",
+    "\n",
+    "# ---------------------------------------------------------------- 유틸\n",
+    "def is_done(key, stem):\n",
+    "    \"\"\"이번 버전(RESULT_SCHEMA)으로 분석이 끝난 조합인지\"\"\"\n",
+    "    jp = BATCH_OUTPUT_DIR / key / f\"{stem}.json\"\n",
+    "    if not (RESUME and jp.exists()):\n",
+    "        return False\n",
+    "    try:\n",
+    "        return json.loads(jp.read_text(encoding=\"utf-8\")).get(\"schema\") == RESULT_SCHEMA\n",
+    "    except Exception:\n",
+    "        return False\n",
+    "\n",
+    "def iou_matrix(a, b):\n",
+    "    a = np.asarray(a, dtype=float).reshape(-1, 4)\n",
+    "    b = np.asarray(b, dtype=float).reshape(-1, 4)\n",
+    "    ix1 = np.maximum(a[:, None, 0], b[None, :, 0])\n",
+    "    iy1 = np.maximum(a[:, None, 1], b[None, :, 1])\n",
+    "    ix2 = np.minimum(a[:, None, 2], b[None, :, 2])\n",
+    "    iy2 = np.minimum(a[:, None, 3], b[None, :, 3])\n",
+    "    inter = np.clip(ix2 - ix1, 0, None) * np.clip(iy2 - iy1, 0, None)\n",
+    "    area_a = (a[:, 2] - a[:, 0]) * (a[:, 3] - a[:, 1])\n",
+    "    area_b = (b[:, 2] - b[:, 0]) * (b[:, 3] - b[:, 1])\n",
+    "    return inter / np.maximum(area_a[:, None] + area_b[None, :] - inter, 1e-6)\n",
+    "\n",
+    "def nms(dets, thr):\n",
+    "    \"\"\"dets: [(x1,y1,x2,y2,conf)] -> conf 높은 순으로 중복 제거\"\"\"\n",
+    "    keep = []\n",
+    "    for d in sorted(dets, key=lambda x: -x[4]):\n",
+    "        if not keep or (iou_matrix([d[:4]], [k[:4] for k in keep]) < thr).all():\n",
+    "            keep.append(d)\n",
+    "    return keep\n",
+    "\n",
+    "def is_person_overlap(t, people, thr=PERSON_OVERLAP):\n",
+    "    \"\"\"trash 박스가 사람 박스 안에 들어가 있거나(사람 일부 오검출),\n",
+    "    사람 박스를 통째로 덮고 있으면(사람 전신 오검출) True\"\"\"\n",
+    "    tx1, ty1, tx2, ty2 = t[:4]\n",
+    "    t_area = max(1, (tx2 - tx1) * (ty2 - ty1))\n",
+    "\n",
+    "    for px1, py1, px2, py2, _ in people:\n",
+    "        p_area = max(1, (px2 - px1) * (py2 - py1))\n",
+    "        iw = min(tx2, px2) - max(tx1, px1)\n",
+    "        ih = min(ty2, py2) - max(ty1, py1)\n",
+    "\n",
+    "        if iw <= 0 or ih <= 0:\n",
+    "            continue\n",
+    "\n",
+    "        inter = iw * ih\n",
+    "\n",
+    "        if inter / t_area >= thr or inter / p_area >= thr:\n",
+    "            return True\n",
+    "\n",
+    "    return False\n",
+    "\n",
+    "# ---------------------------------------------------------------- 1) 원본 검출\n",
+    "def detect_people(frame):\n",
+    "    pr = person_model.predict(\n",
+    "        frame, classes=[0], conf=PERSON_CONF,\n",
+    "        imgsz=VIDEO_IMGSZ, device=DEVICE, verbose=False\n",
+    "    )[0]\n",
+    "\n",
+    "    people = []\n",
+    "    if pr.boxes is not None:\n",
+    "        for box, conf in zip(pr.boxes.xyxy.tolist(), pr.boxes.conf.tolist()):\n",
+    "            x1, y1, x2, y2 = map(int, box)\n",
+    "            people.append((x1, y1, x2, y2, float(conf)))\n",
+    "    return people\n",
+    "\n",
+    "def _extract(res, ox=0, oy=0):\n",
+    "    out = []\n",
+    "    if res.boxes is not None:\n",
+    "        for box, conf in zip(res.boxes.xyxy.tolist(), res.boxes.conf.tolist()):\n",
+    "            x1, y1, x2, y2 = box\n",
+    "            out.append((int(x1) + ox, int(y1) + oy, int(x2) + ox, int(y2) + oy, float(conf)))\n",
+    "    return out\n",
+    "\n",
+    "def tile_slices(w, h):\n",
+    "    cols, rows = TRASH_TILES\n",
+    "    tw = int(round(w / (cols - (cols - 1) * TILE_OVERLAP)))\n",
+    "    th = int(round(h / (rows - (rows - 1) * TILE_OVERLAP)))\n",
+    "    sx = int(round(tw * (1 - TILE_OVERLAP)))\n",
+    "    sy = int(round(th * (1 - TILE_OVERLAP)))\n",
+    "    return [(min(c * sx, w - tw), min(r * sy, h - th), tw, th)\n",
+    "            for r in range(rows) for c in range(cols)]\n",
+    "\n",
+    "def detect_trash_raw(model, frame, conf):\n",
+    "    \"\"\"전체 프레임 + 타일(확대) 추론 결과를 합쳐서 반환. 작은 쓰레기를 놓치지 않기 위함\"\"\"\n",
+    "    kw = dict(conf=conf, imgsz=VIDEO_IMGSZ, device=DEVICE, verbose=False)\n",
+    "    h, w = frame.shape[:2]\n",
+    "\n",
+    "    dets = _extract(model.predict(frame, **kw)[0])\n",
+    "\n",
+    "    if TRASH_TILES[0] * TRASH_TILES[1] > 1:\n",
+    "        tiles = tile_slices(w, h)\n",
+    "        crops = [frame[y:y + th, x:x + tw] for x, y, tw, th in tiles]\n",
+    "        for res, (x, y, _, _) in zip(model.predict(crops, **kw), tiles):\n",
+    "            dets += _extract(res, x, y)\n",
+    "\n",
+    "    return nms(dets, NMS_IOU)\n",
+    "\n",
+    "# ---------------------------------------------------------------- 2) 후처리\n",
+    "def split_people(people_by_frame, n_frames, frame_h):\n",
+    "    \"\"\"집계에 쓸 사람(counted)과 제외할 사람(ignored)을 분리\n",
+    "       제외: (1) 영상 내내 같은 자리에 있는 사람(촬영자 등)  (2) 화면 대비 너무 작은 사람(먼 곳)\"\"\"\n",
+    "    flat = [(f, p) for f, ps in enumerate(people_by_frame) for p in ps]\n",
+    "    counted = [[] for _ in people_by_frame]\n",
+    "    ignored = [[] for _ in people_by_frame]\n",
+    "    if not flat:\n",
+    "        return counted, ignored\n",
+    "\n",
+    "    boxes = np.array([p[:4] for _, p in flat], dtype=float)\n",
+    "    ratio = (iou_matrix(boxes, boxes) >= 0.7).sum(axis=1) / max(1, n_frames)\n",
+    "\n",
+    "    for (f, p), r in zip(flat, ratio):\n",
+    "        too_small = (p[3] - p[1]) < MIN_PERSON_HEIGHT_RATIO * frame_h\n",
+    "        (ignored if (r >= STATIC_PERSON_RATIO or too_small) else counted)[f].append(p)\n",
+    "    return counted, ignored\n",
+    "\n",
+    "def build_baseline(dets_by_frame, fps):\n",
+    "    \"\"\"영상 초반 N초에 계속 보이던 정적 객체 박스 목록 (바위, 돌 등 오검출 + 기존 쓰레기)\"\"\"\n",
+    "    n0 = max(1, int(BASELINE_SEC * fps))\n",
+    "    head = dets_by_frame[:n0]\n",
+    "    flat = [(f, d) for f, ds in enumerate(head) for d in ds]\n",
+    "    if not flat:\n",
+    "        return []\n",
+    "\n",
+    "    boxes = np.array([d[:4] for _, d in flat], dtype=float)\n",
+    "    fidx = np.array([f for f, _ in flat])\n",
+    "    iou = iou_matrix(boxes, boxes)\n",
+    "\n",
+    "    base = []\n",
+    "    for i in range(len(boxes)):\n",
+    "        frames_hit = len(set(fidx[iou[i] >= 0.3]))\n",
+    "        if frames_hit / len(head) >= BASELINE_MIN_RATIO:\n",
+    "            if not base or (iou_matrix([boxes[i]], base) < 0.5).all():\n",
+    "                base.append(boxes[i])\n",
+    "    return base\n",
+    "\n",
+    "def match_baseline(d, base):\n",
+    "    if not base:\n",
+    "        return False\n",
+    "    if (iou_matrix([d[:4]], base) >= 0.25).any():\n",
+    "        return True\n",
+    "    cx, cy = (d[0] + d[2]) / 2, (d[1] + d[3]) / 2\n",
+    "    return any(b[0] <= cx <= b[2] and b[1] <= cy <= b[3] for b in base)\n",
+    "\n",
+    "def build_tracks(dets_by_frame):\n",
+    "    \"\"\"프레임 간 IoU로 검출을 이어붙임. 끊김은 MAX_TRACK_GAP까지 허용\"\"\"\n",
+    "    tracks = []\n",
+    "    for f, dets in enumerate(dets_by_frame):\n",
+    "        active = [t for t in tracks if f - t[\"last\"] <= MAX_TRACK_GAP + 1]\n",
+    "        used_t, used_d = set(), set()\n",
+    "\n",
+    "        if dets and active:\n",
+    "            iou = iou_matrix([d[:4] for d in dets], [t[\"box\"] for t in active])\n",
+    "            pairs = sorted(\n",
+    "                ((iou[a, b], a, b) for a in range(len(dets)) for b in range(len(active)) if iou[a, b] >= 0.2),\n",
+    "                reverse=True\n",
+    "            )\n",
+    "            for _, a, b in pairs:\n",
+    "                if a in used_d or b in used_t:\n",
+    "                    continue\n",
+    "                t = active[b]\n",
+    "                t[\"dets\"][f] = dets[a]\n",
+    "                t[\"box\"], t[\"last\"] = dets[a][:4], f\n",
+    "                used_d.add(a); used_t.add(b)\n",
+    "\n",
+    "        for a, d in enumerate(dets):\n",
+    "            if a not in used_d:\n",
+    "                tracks.append({\"dets\": {f: d}, \"box\": d[:4], \"last\": f})\n",
+    "    return tracks\n",
+    "\n",
+    "def postprocess_trash(raw, people_raw, fps):\n",
+    "    n = len(raw)\n",
+    "\n",
+    "    # (a) 사람 박스와 겹치는 trash 제거\n",
+    "    removed, kept = [], []\n",
+    "    for f in range(n):\n",
+    "        ds = [d for d in raw[f] if not is_person_overlap(d, people_raw[f])]\n",
+    "        removed.append(len(raw[f]) - len(ds))\n",
+    "        kept.append(ds)\n",
+    "\n",
+    "    # (b) 영상 초반부터 있던 정적 객체는 배경으로 분리\n",
+    "    base = build_baseline(kept, fps)\n",
+    "    cand, static = [], []\n",
+    "    for ds in kept:\n",
+    "        cand.append([d for d in ds if not match_baseline(d, base)])\n",
+    "        static.append([d for d in ds if match_baseline(d, base)])\n",
+    "\n",
+    "    # (c) 추적 -> 일정 프레임 이상 유지된 것만 \"새 쓰레기\"로 인정, 끊긴 구간은 이어서 표시\n",
+    "    tracks = [t for t in build_tracks(cand) if len(t[\"dets\"]) >= MIN_TRACK_HITS]\n",
+    "    new = [[] for _ in range(n)]\n",
+    "    for t in tracks:\n",
+    "        first, last = min(t[\"dets\"]), max(t[\"dets\"])\n",
+    "        cur = t[\"dets\"][first]\n",
+    "        for f in range(first, last + 1):\n",
+    "            cur = t[\"dets\"].get(f, cur)\n",
+    "            new[f].append(cur)\n",
+    "\n",
+    "    return {\n",
+    "        \"new\": new, \"static\": static, \"removed\": removed,\n",
+    "        \"new_objects\": len(tracks),\n",
+    "        \"first_new_sec\": round(min(min(t[\"dets\"]) for t in tracks) / fps, 2) if tracks else -1,\n",
+    "        \"baseline_objects\": len(base),\n",
+    "    }\n",
+    "\n",
+    "# ---------------------------------------------------------------- 3) 시각화 / 요약\n",
+    "def annotate(frame, people, static_people, new, static, sec, tag):\n",
+    "    out = frame.copy()\n",
+    "\n",
+    "    for x1, y1, x2, y2, _ in static_people:                       # 정적 사람(제외됨): 회색\n",
+    "        cv2.rectangle(out, (x1, y1), (x2, y2), (150, 150, 150), 2)\n",
+    "    for x1, y1, x2, y2, _ in static:                              # 초반부터 있던 객체(제외됨): 노란색\n",
+    "        cv2.rectangle(out, (x1, y1), (x2, y2), (0, 220, 255), 2)\n",
+    "\n",
+    "    for x1, y1, x2, y2, conf in people:\n",
+    "        cv2.rectangle(out, (x1, y1), (x2, y2), (0, 255, 0), 3)\n",
+    "        cv2.putText(out, f\"PERSON {conf:.2f}\", (x1, max(30, y1 - 10)),\n",
+    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2, cv2.LINE_AA)\n",
+    "\n",
+    "    for x1, y1, x2, y2, conf in new:\n",
+    "        cv2.rectangle(out, (x1, y1), (x2, y2), (0, 0, 255), 3)\n",
+    "        cv2.putText(out, f\"TRASH {conf:.2f}\", (x1, max(30, y1 - 10)),\n",
+    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2, cv2.LINE_AA)\n",
+    "\n",
+    "    cv2.rectangle(out, (10, 10), (900, 65), (0, 0, 0), -1)\n",
+    "    cv2.putText(out, f\"[{tag}] {sec:.1f}s | Person: {len(people)} | New trash: {len(new)} | Static: {len(static)}\",\n",
+    "                (20, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (255, 255, 255), 2, cv2.LINE_AA)\n",
+    "    return out\n",
+    "\n",
+    "def summarize(stem, key, rows, confs, fps, extra):\n",
+    "    \"\"\"rows: [frame, sec, persons, trash, max_conf, removed, static]\"\"\"\n",
+    "    a = np.array(rows, dtype=float)\n",
+    "    n = len(a)\n",
+    "    persons, trash, removed = a[:, 2], a[:, 3], a[:, 5]\n",
+    "\n",
+    "    # 사람이 한 번 나타난 뒤, 사람이 없는데 새 쓰레기가 남아 있는 프레임 (투기 후보 신호)\n",
+    "    left_behind = 0\n",
+    "    if (persons > 0).any():\n",
+    "        first_person = int(np.argmax(persons > 0))\n",
+    "        left_behind = int(((np.arange(n) > first_person) & (persons == 0) & (trash > 0)).sum())\n",
+    "\n",
+    "    k = max(1, int(n * 0.1))\n",
+    "    trash_start = float(np.median(trash[:k]))\n",
+    "    trash_end = float(np.median(trash[-k:]))\n",
+    "\n",
+    "    return {\n",
+    "        \"schema\": RESULT_SCHEMA,\n",
+    "        \"video\": stem,\n",
+    "        \"label\": video_label(stem),\n",
+    "        \"model\": key,\n",
+    "        \"frames\": n,\n",
+    "        \"fps\": round(float(fps), 3),\n",
+    "        \"duration_sec\": round(n / fps, 2) if fps > 0 else 0,\n",
+    "        \"person_frames\": int((persons > 0).sum()),\n",
+    "        \"person_ratio\": round(float((persons > 0).mean()), 4),\n",
+    "        \"max_persons\": int(persons.max()),\n",
+    "        \"trash_frames\": int((trash > 0).sum()),\n",
+    "        \"trash_ratio\": round(float((trash > 0).mean()), 4),\n",
+    "        \"total_trash_det\": int(trash.sum()),\n",
+    "        \"max_trash\": int(trash.max()),\n",
+    "        \"avg_trash_conf\": round(float(np.mean(confs)), 4) if confs else 0.0,\n",
+    "        \"low_conf_ratio\": round(float(np.mean(np.array(confs) < LOW_CONF)), 4) if confs else 0.0,\n",
+    "        \"removed_by_person\": int(removed.sum()),\n",
+    "        \"trash_count_changes\": int((np.diff(trash) != 0).sum()),   # 클수록 깜빡임이 많음\n",
+    "        \"left_behind_frames\": left_behind,\n",
+    "        \"trash_start\": trash_start,\n",
+    "        \"trash_end\": trash_end,\n",
+    "        \"net_new_trash\": trash_end - trash_start,                 # 영상 끝에 늘어난 쓰레기 수\n",
+    "        \"new_trash_objects\": extra[\"new_objects\"],                # 새로 나타난 쓰레기 개수(추적 기준)\n",
+    "        \"first_new_trash_sec\": extra[\"first_new_sec\"],            # 처음 새 쓰레기가 나타난 시각\n",
+    "        \"baseline_objects\": extra[\"baseline_objects\"],            # 배경으로 제외한 정적 객체 수\n",
+    "    }\n",
+    "\n",
+    "# ---------------------------------------------------------------- 메인 루프\n",
+    "for key in trash_models:\n",
+    "    (BATCH_OUTPUT_DIR / key).mkdir(parents=True, exist_ok=True)\n",
+    "    if key in SAVE_VIDEO_FOR:\n",
+    "        (RESULT_VIDEO_DIR / key).mkdir(parents=True, exist_ok=True)\n",
+    "\n",
+    "failed = []\n",
+    "\n",
+    "for vp in tqdm(VIDEO_PATHS, desc=\"영상\", unit=\"video\"):\n",
+    "\n",
+    "    stem = vp.stem\n",
+    "\n",
+    "    active = [k for k in trash_models if not is_done(k, stem)]\n",
+    "\n",
+    "    if not active:\n",
+    "        continue\n",
+    "\n",
+    "    cap = cv2.VideoCapture(str(vp))\n",
+    "    writers = {}\n",
+    "\n",
+    "    try:\n",
+    "        if not cap.isOpened():\n",
+    "            raise RuntimeError(\"영상 열기 실패\")\n",
+    "\n",
+    "        fps = cap.get(cv2.CAP_PROP_FPS)\n",
+    "        if fps <= 0:\n",
+    "            fps = 25.0\n",
+    "        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
+    "        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
+    "        total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
+    "\n",
+    "        # ---- 1) 원본 검출 (사람은 프레임당 1번만)\n",
+    "        people_raw = []\n",
+    "        raw = {k: [] for k in active}\n",
+    "\n",
+    "        with tqdm(total=total, desc=video_label(stem), unit=\"frame\", leave=False) as pbar:\n",
+    "            while True:\n",
+    "                ok, frame = cap.read()\n",
+    "                if not ok:\n",
+    "                    break\n",
+    "                people_raw.append(detect_people(frame))\n",
+    "                for k in active:\n",
+    "                    raw[k].append(detect_trash_raw(trash_models[k], frame, CONF_BY_MODEL.get(k, VIDEO_CONF)))\n",
+    "                pbar.update(1)\n",
+    "        cap.release()\n",
+    "\n",
+    "        n = len(people_raw)\n",
+    "        if n == 0:\n",
+    "            raise RuntimeError(\"읽은 프레임이 없습니다\")\n",
+    "\n",
+    "        # ---- 2) 후처리\n",
+    "        people_moving, people_static = split_people(people_raw, n, height)\n",
+    "        res = {k: postprocess_trash(raw[k], people_raw, fps) for k in active}\n",
+    "\n",
+    "        rows, confs = {}, {}\n",
+    "        for k in active:\n",
+    "            r = res[k]\n",
+    "            rows[k] = [\n",
+    "                [f, round(f / fps, 3), len(people_moving[f]), len(r[\"new\"][f]),\n",
+    "                 round(max([d[4] for d in r[\"new\"][f]], default=0), 6),\n",
+    "                 r[\"removed\"][f], len(r[\"static\"][f])]\n",
+    "                for f in range(n)\n",
+    "            ]\n",
+    "            confs[k] = [d[4] for ds in r[\"new\"] for d in ds]\n",
+    "\n",
+    "        # ---- 3) 결과 영상 저장 (영상을 다시 한 번 읽어서 그림)\n",
+    "        save_keys = [k for k in active if k in SAVE_VIDEO_FOR]\n",
+    "        if save_keys:\n",
+    "            for k in save_keys:\n",
+    "                w = cv2.VideoWriter(\n",
+    "                    str(RESULT_VIDEO_DIR / k / f\"{stem}.mp4\"),\n",
+    "                    cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (width, height)\n",
+    "                )\n",
+    "                if not w.isOpened():\n",
+    "                    raise RuntimeError(\"결과 영상 writer 생성 실패\")\n",
+    "                writers[k] = w\n",
+    "\n",
+    "            cap = cv2.VideoCapture(str(vp))\n",
+    "            for f in range(n):\n",
+    "                ok, frame = cap.read()\n",
+    "                if not ok:\n",
+    "                    break\n",
+    "                for k in save_keys:\n",
+    "                    writers[k].write(annotate(\n",
+    "                        frame, people_moving[f], people_static[f],\n",
+    "                        res[k][\"new\"][f], res[k][\"static\"][f], f / fps, k\n",
+    "                    ))\n",
+    "            cap.release()\n",
+    "\n",
+    "        # ---- 4) CSV / 요약 저장 (json은 마지막 -> 이게 있으면 해당 조합은 \"완료\")\n",
+    "        for k in active:\n",
+    "            with open(BATCH_OUTPUT_DIR / k / f\"{stem}.csv\", \"w\", newline=\"\", encoding=\"utf-8-sig\") as fcsv:\n",
+    "                cw = csv.writer(fcsv)\n",
+    "                cw.writerow(CSV_HEADER)\n",
