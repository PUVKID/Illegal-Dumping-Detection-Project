-        for info in zipped.infolist():
-            path = PurePosixPath(info.filename.replace('\\','/'))
-            if path.is_absolute() or '..' in path.parts or ':' in info.filename or stat.S_ISLNK(info.external_attr >> 16):
-                raise ValueError('ZIP에 허용하지 않는 경로가 있습니다.')
-            if info.is_dir():
