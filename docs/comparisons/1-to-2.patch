+    "            r.boxes = _DummyBoxes(cls=[0], conf=[0.9])\n",
+    "            return [r]\n",
+    "    return _M()\n",
+    "\n",
+    "\n",
+    "def _stationary_person_detector(box=(140, 170, 210, 230), start_at=4):\n",
+    "    '''start_at 시점부터 항상 같은 자리에 사람이 있는 것처럼 반환 (정지한 사람 시뮬레이션)'''\n",
+    "    state = {\"i\": 0}\n",
