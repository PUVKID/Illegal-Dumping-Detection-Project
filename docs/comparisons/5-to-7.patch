+def remaining_seconds(elapsed,hours):
+    if not math.isfinite(elapsed) or elapsed<0 or hours*3600-elapsed<=0:
+        raise ValueError('후보의 누적 학습 시간 예산이 끝났거나 잘못됐습니다.')
