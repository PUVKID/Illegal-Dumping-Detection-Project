+            raise ValueError('완료 학습 가중치가 보존 해시와 다릅니다.')
+        return 'complete'
+    if (directory/'weights/last.pt').exists():
+        if not path.exists() or not allow_resume:raise ValueError('중단 checkpoint는 동일 계약과 명시적 재개가 필요합니다.')
