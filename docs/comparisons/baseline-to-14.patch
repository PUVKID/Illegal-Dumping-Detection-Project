+    {'source':'pLitterStreet','record':'8288500','name':'images.zip','size':13728630001,
+     'md5':'02382a3b9620ae7b086ff4c7fd11891d'},
+    {'source':'pLitterStreet','record':'8288500','name':'annotations.zip','size':8764662,
